# RioMisc MVP-1 environment
# Master key for the encrypted secrets file (AES-256-GCM). REQUIRED if you store API keys.
CTF_RUNTIME_MASTER_KEY=change-me-to-a-long-random-string

# Optional API keys (used by SecretStore.set if you don't want to use the Dashboard)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Server bind
RIO_HOST=127.0.0.1
RIO_PORT=3000

# Data root — overrides config/runtime.yaml paths.dataDir when set.
# On cloud disks put this on the large volume, e.g. /data/rio-misc
# RIO_DATA_DIR=./data
# RIO_DATA_DIR=/data/rio-misc
